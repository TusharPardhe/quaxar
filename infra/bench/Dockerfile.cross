# Cross-compiles quaxar for linux/amd64 natively on an arm64 host (no
# emulated compilation), so it can be benchmarked under the same amd64
# emulation as the prebuilt rippled images.
FROM rust:1.90-bookworm
RUN dpkg --add-architecture amd64 && apt-get update && apt-get install -y --no-install-recommends \
        crossbuild-essential-amd64 libssl-dev:amd64 clang cmake pkg-config perl \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add x86_64-unknown-linux-gnu
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc \
    CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc \
    CXX_x86_64_unknown_linux_gnu=x86_64-linux-gnu-g++ \
    AR_x86_64_unknown_linux_gnu=x86_64-linux-gnu-ar \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_PATH_x86_64_unknown_linux_gnu=/usr/lib/x86_64-linux-gnu/pkgconfig \
    X86_64_UNKNOWN_LINUX_GNU_OPENSSL_LIB_DIR=/usr/lib/x86_64-linux-gnu \
    X86_64_UNKNOWN_LINUX_GNU_OPENSSL_INCLUDE_DIR=/usr/include \
    CARGO_INCREMENTAL=0
WORKDIR /src
